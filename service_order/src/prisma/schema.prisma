generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model brands {
  brand_id   Int    @id @default(autoincrement())
  brand_name String @db.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  category_id      Int          @id @default(autoincrement())
  level            Int?         @default(1) @db.SmallInt
  category_name    String       @db.VarChar(255)
  parent_id        Int?
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

model customers {
  customer_id Int    @id @default(autoincrement())
  email       String @db.VarChar(255)
  password    String @db.VarChar(255)
  phone       String @db.VarChar(25)
  address     String @db.VarChar(255)
  accountName String @default("") @db.VarChar(255)
  surname     String @default("") @db.VarChar(255)
  name        String @default("") @db.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orderItems {
  orderItems_id Int      @id @default(autoincrement())
  order_id      Int
  product_id    Int
  qty           Int
  price         Int
  orders        orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products      products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
}

model orders {
  order_id     Int            @id @default(autoincrement())
  customer_id  Int
  total_price  Int
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  orderItems   orderItems[]
  status_Order status_Order[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  product_id    Int          @id @default(autoincrement())
  image         String[]     @db.VarChar(1255)
  name          String       @db.VarChar(255)
  title         String       @db.VarChar(1000)
  price         Int
  star          Float        @db.Real
  isTopDeal     Boolean?
  isAuthentic   Boolean?
  sale_percent  Int?         @db.SmallInt
  shipping_type String       @db.VarChar(55)
  shipping_date String       @db.VarChar(50)
  isGlobal      Boolean
  madeIn        String       @db.VarChar(255)
  shop_id       Int
  category_id   Int
  inventory     Int          @default(0) @db.SmallInt
  sold          Int?         @default(0) @db.SmallInt
  orderItems    orderItems[]
  categories    categories   @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)
  shops         shops        @relation(fields: [shop_id], references: [shop_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shops {
  shop_id   Int        @id @default(autoincrement())
  logo      String     @db.VarChar(255)
  shop_name String     @db.VarChar(255)
  star      Float      @db.Real
  official  Boolean
  email     String     @db.VarChar(255)
  phone     String     @db.VarChar(25)
  password  String     @default("1234") @db.VarChar(255)
  products  products[]
}

model slidersBanner {
  id    Int    @id @default(autoincrement())
  image String @db.VarChar(255)
}

model status_Order {
  statusOrder_id Int     @id @default(autoincrement())
  order_id       Int
  status0        Boolean
  status1        Boolean
  status2        Boolean
  status3        Boolean
  status4        Boolean
  status5        Boolean
  status6        Boolean
  orders         orders  @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}
